# 服务端口
PORT=8080

# 微信小游戏
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# JWT / 会话
JWT_SECRET=change_me_in_prod

# MySQL（接入 TypeORM 后使用）
DB_HOST=127.0.0.1
DB_PORT=3306
